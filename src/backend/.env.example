APP_NAME=H-UMDG
APP_DISPLAY_NAME=医院统一主数据治理平台
APP_ENV=development
SERVER_PORT=8101
FRONTEND_PORT=5101
DATABASE_URL=
UPLOAD_DIR=./storage/uploads
LOG_DIR=./storage/logs
BACKUP_DIR=./storage/backups
REDIS_URL=redis://localhost:6379/0
API_KEY=change-me
OPERATOR_SESSION_TTL_MINUTES=480
OPERATOR_USERS=admin|admin123|platform_admin|平台管理员;E1001|demo123|data_steward|数据治理员;AUD001|audit123|auditor|审计员
CORS_ORIGINS=http://127.0.0.1:5101,http://localhost:5101

# 导入源与运行时目录均使用相对路径，避免绑定本机绝对目录。
UMDG_REPO_ROOT=../../
UMDG_NHSA_DIR=../../data/samples/external/nhsa
UMDG_DEVICE_CATALOG_DOCX=../../data/samples/external/nmpa/医疗器械分类目录.docx
UMDG_IMPORT_SPOOL_DIR=./runtime/import-spool
UMDG_IMPORT_MAX_UPLOAD_BYTES=1073741824
UMDG_IMPORT_MAX_ARCHIVE_ENTRIES=200
UMDG_IMPORT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=4294967296
UMDG_IMPORT_CLEANUP_SPOOL_ON_FINISH=true

# 兼容旧环境变量名：历史目录/旧项目名为 H-UDMP，旧部署可继续使用 HUDMP_*。
# HUDMP_REPO_ROOT=../../
