APP_NAME=H-UMDG
APP_DISPLAY_NAME=医院统一主数据治理平台
APP_ENV=development
SERVER_PORT=8101
FRONTEND_PORT=5101
UPLOAD_DIR=./storage/uploads
LOG_DIR=./storage/logs
BACKUP_DIR=./storage/backups

# PostgreSQL 是硬性要求。不设置 DATABASE_URL 时，后端代码默认使用以下连接串。
# 若使用其它本地库，请取消下一行注释并改为实际连接串；不要保留 DATABASE_URL= 空值。
DATABASE_URL=postgresql+psycopg://umdg:umdg@localhost:5432/umdg
REDIS_URL=redis://localhost:6379/0
API_KEY=change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me-in-production-min-32-chars!!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:5101,http://localhost:5101
API_VERSION_LABEL=mvp-v1

# 导入源与运行时目录均使用相对路径，避免绑定本机绝对目录。
UMDG_REPO_ROOT=../../
UMDG_NHSA_DIR=../../data/samples/external/nhsa
UMDG_DEVICE_CATALOG_DOCX=../../data/samples/external/nmpa/医疗器械分类目录.docx
UMDG_IMPORT_SPOOL_DIR=./runtime/import-spool
UMDG_EQUIPMENT_SOURCE_DIR=./runtime/equipment-source-files
UMDG_IMPORT_MAX_UPLOAD_BYTES=1073741824
UMDG_IMPORT_MAX_ARCHIVE_ENTRIES=200
UMDG_IMPORT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=4294967296
UMDG_IMPORT_CLEANUP_SPOOL_ON_FINISH=true

# 兼容旧环境变量名：历史目录/旧项目名为 H-UDMP，旧部署可继续使用 HUDMP_*。
# HUDMP_REPO_ROOT=../../
