# H-UMDG Docker Compose 环境变量模板
# 复制为 deploy/docker/.env 后按需修改

# PostgreSQL
POSTGRES_USER=umdg
POSTGRES_PASSWORD=umdg
POSTGRES_DB=umdg
POSTGRES_PORT=5432

# Redis（可选扩展）
REDIS_PORT=6379

# H-UMDG API 后端
UMDG_SERVER_PORT=8000
UMDG_LOG_LEVEL=INFO
UMDG_API_KEY=change-me

# 生产必须设置强随机密钥，勿用仓库默认值
UMDG_OPERATOR_USERS=admin|admin123|platform_admin|平台管理员

# CORS（部署后修改为实际前端地址）
UMDG_CORS_ORIGINS=http://localhost:5101

# 数据目录映射（宿主机路径）
UMDG_STORAGE_DIR=./storage
